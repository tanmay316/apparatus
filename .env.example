# Firebase Configuration — obtain from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Admin email — the email address granted admin privileges
VITE_ADMIN_EMAIL=

# iOS only — Google OAuth "iOS" client id from Firebase Console > Project Settings
# > iOS app (also present in GoogleService-Info.plist as CLIENT_ID).
# Required for native Google Sign-In on iPhone; ignored on Android/web.
VITE_GOOGLE_IOS_CLIENT_ID=
